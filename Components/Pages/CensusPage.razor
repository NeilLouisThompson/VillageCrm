@page "/census"
@inherits ViewerAwarePage
@inject ResidentService Residents
@inject RestaurantService Restaurant

<PageTitle>Daily census</PageTitle>

<h1>Daily census - @Format.Date(DateTime.Today)</h1>

<RoleGate Area="Area.Census">
    @if (_census is not null)
    {
        @if (_welfare.Count > 0)
        {
            <div class="card warning" role="alert">
                <h2>Welfare check: missed meals</h2>
                <ul>
                    @foreach (var w in _welfare)
                    {
                        <li><a href="residents/@w.Resident.Id">@w.Resident.FullName</a> (unit @w.Resident.Unit): last dining room meal @(w.LastMeal is null ? "not recorded" : Format.Date(w.LastMeal))</li>
                    }
                </ul>
            </div>
        }
        <div class="stats">
            <div class="stat"><span class="stat-value">@_census.InVillage</span>In the village</div>
            <div class="stat"><span class="stat-value">@_census.Away</span>Away</div>
            <div class="stat"><span class="stat-value">@_census.Hospital</span>In hospital</div>
            <div class="stat"><span class="stat-value">@_census.FrailCare</span>Frail care</div>
        </div>

        @foreach (var group in _census.Residents.GroupBy(r => r.Status).OrderBy(g => g.Key))
        {
            <div class="card">
                <h2>@Format.Words(group.Key) (@group.Count())</h2>
                <table class="big-table">
                    <thead><tr><th>Name</th><th>Unit</th><th>Care level</th><th>Last movement</th></tr></thead>
                    <tbody>
                        @foreach (var r in group.OrderBy(r => r.Unit))
                        {
                            var last = r.Movements.FirstOrDefault();
                            <tr>
                                <td><a href="residents/@r.Id">@r.FullName</a></td>
                                <td>@r.Unit</td>
                                <td>@Format.Words(r.CareLevel)</td>
                                <td>@(last is null ? "" : $"{Format.Words(last.Type)} - {Format.When(last.When)}")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</RoleGate>

@code {
    private Census? _census;
    private List<WelfareAlert> _welfare = [];

    protected override async Task OnInitializedAsync()
    {
        _census = await Residents.GetCensusAsync();
        _welfare = await Restaurant.WelfareAlertsAsync();
    }
}
