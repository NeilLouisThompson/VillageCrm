@page "/"
@inherits ViewerAwarePage
@inject IOptions<VillageOptions> Options

<PageTitle>@Options.Value.VillageName</PageTitle>

@if (Viewer.IsResident)
{
    <h1>Hello, @Viewer.Name</h1>
    <div class="tiles home-tiles">
        <a class="tile tile-primary" href="report"><span class="tile-icon" aria-hidden="true">🔧</span>Report a problem</a>
        <a class="tile" href="meals"><span class="tile-icon" aria-hidden="true">🍽️</span>Meals</a>
        <a class="tile" href="my-requests"><span class="tile-icon" aria-hidden="true">📋</span>My requests</a>
        <a class="tile" href="notices"><span class="tile-icon" aria-hidden="true">📢</span>Notices</a>
        <a class="tile" href="tel:@Options.Value.ReceptionPhone"><span class="tile-icon" aria-hidden="true">📞</span>Call reception</a>
    </div>
}
else
{
    <h1>@Options.Value.VillageName</h1>
    <p class="lead">Good day, @Viewer.Name (@Access.Label(Viewer.Role)). Demonstration system: all names and records are made up.</p>
    <div class="tiles">
        @foreach (var link in Access.NavLinks(Viewer.Role))
        {
            <a class="tile" href="@link.Href">@link.Text</a>
        }
    </div>
}
